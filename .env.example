# Bu dosyayı .env olarak kopyala:  copy .env.example .env   (Mac/Linux: cp)
# .env dosyası git'e GİRMEZ. Şifren SADECE burada, senin bilgisayarında durur.
# Şifreni kimseyle paylaşma, hiçbir sohbete ya da yapay zekâya yapıştırma.

# Mod: sim (sanal para, hesap gerekmez) | live (senin MT5 hesabın)
BOT_MODE=sim

# MetaTrader 5 hesabın: MT5'te Dosya -> Hesaba Giriş penceresindeki bilgiler.
# Şifre ANA (trading) şifren olmalı; yatırımcı (salt okunur) şifresiyle işlem açılamaz.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# MT5 birden fazla kuruluysa terminal64.exe yolu (gerekmiyorsa boş bırak):
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Sunucu saati UTC'den kaç saat ileri (boşsa bot kendisi hesaplar):
# MT5_SUNUCU_SAAT_FARKI=2

# Hesabında işlem açılması için zorunlu onay. Hazır olduğunda aç:
# BOT_LIVE_CONFIRM=GERCEK_PARA
