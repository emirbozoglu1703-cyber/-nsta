# Bu dosyayı .env olarak kopyala:  cp .env.example .env
# .env dosyası git'e GİRMEZ. Şifreler SADECE burada, senin bilgisayarında durur.
# Şifreni kimseyle paylaşma, sohbete/yapay zekâya yapıştırma.

# Piyasa: forex (MetaTrader 5) | bist (Deniz Yatırım AlgoLab)
BOT_MARKET=forex

# Mod: sim (sanal para, hesap gerekmez) | live (senin hesabın)
BOT_MODE=sim

# ---------- Forex: MetaTrader 5 hesabın ----------
# MT5'te: Dosya -> Hesaba Giriş penceresindeki bilgiler.
# Şifre: ANA (trading) şifren olmalı; yatırımcı (salt okunur) şifresiyle işlem açılamaz.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# MT5 birden fazla kuruluysa terminal64.exe yolu (gerekmiyorsa boş bırak):
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# Sunucu saati UTC'den kaç saat ileri (boşsa bot kendisi hesaplar):
# MT5_SUNUCU_SAAT_FARKI=2

# ---------- BIST: Deniz Yatırım AlgoLab ----------
ALGOLAB_API_KEY=
# ALGOLAB_USERNAME=TC_KIMLIK_NO
# ALGOLAB_PASSWORD=

# Gerçek hesapta işlem için zorunlu onay. Hazır olduğunda aç:
# BOT_LIVE_CONFIRM=GERCEK_PARA
