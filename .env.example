# Bu dosyayı .env olarak kopyala:  cp .env.example .env
# .env dosyası git'e GİRMEZ (gizli anahtarlar burada durur).

# Mod: sim (sanal, anahtarsız) | paper (Alpaca sanal hesap) | live (GERÇEK PARA)
BOT_MODE=sim

# Alpaca anahtarları: https://app.alpaca.markets -> API Keys
# paper için Paper hesabın anahtarları, live için canlı hesabın anahtarları.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Ücretsiz plan: iex. Ücretli veri aboneliğin varsa: sip
ALPACA_DATA_FEED=iex

# Canlı modda zorunlu onay. Gerçek parayla çalıştırmak istediğinde aç:
# BOT_LIVE_CONFIRM=GERCEK_PARA
