# Bu dosyayı .env olarak kopyala:  cp .env.example .env
# .env dosyası git'e GİRMEZ (gizli bilgiler burada durur).

# Mod: sim (sanal para, hesap gerekmez) | live (GERÇEK PARA, Deniz Yatırım AlgoLab)
BOT_MODE=sim

# Deniz Yatırım AlgoLab API anahtarı (algolab.com.tr üzerinden başvurulur)
ALGOLAB_API_KEY=

# İstersen giriş bilgileri. Boş bırakırsan 'giris' komutu sorar (daha güvenli).
# ALGOLAB_USERNAME=TC_KIMLIK_NO
# ALGOLAB_PASSWORD=

# Canlı modda zorunlu onay. Gerçek parayla çalıştırmak istediğinde aç:
# BOT_LIVE_CONFIRM=GERCEK_PARA
